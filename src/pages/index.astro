---
const projects = [
  {
    id: 'fragment',
    name: 'Fragment',
    summary: '흩어진 기록을 하나의 흐름으로',
    description:
      '메모를 수집하고 연결하며, 다시 꺼내 읽기 쉽게 정리하는 개인 지식 관리 도구를 상상했습니다.',
    approach: '태그와 연결된 노트로 수집부터 다시 읽기까지의 탐색 흐름을 단순하게 구성한 예시입니다.',
    tags: ['Web app', 'React', 'TypeScript'],
    label: 'YOUR SECOND MEMORY',
    heading: '생각이 모이는 곳.',
    cells: ['노트', '연결', '태그'],
    symbols: ['Aa', '↗', '⌘'],
  },
  {
    id: 'quiet-metrics',
    name: 'Quiet Metrics',
    summary: '필요한 지표에만 집중하는 대시보드',
    description:
      '복잡한 분석 화면에서 벗어나, 서비스 상태를 한눈에 파악하도록 설계한 가상의 대시보드입니다.',
    approach: '정보의 우선순위와 일관된 지표 표현을 통해 요약에서 상세로 이어지는 경험을 탐구합니다.',
    tags: ['Dashboard', 'Astro', 'Data'],
    label: 'OVERVIEW / THIS WEEK',
    heading: 'Less noise. More signal.',
    cells: ['방문', '이벤트', '전환'],
    symbols: ['—', '—', '—'],
  },
  {
    id: 'plain-ui',
    name: 'Plain UI',
    summary: '기본에 충실한 인터페이스 실험',
    description:
      '명확한 위계와 키보드 탐색을 중심으로, 재사용 가능한 흑백 인터페이스를 탐구하는 가상의 실험입니다.',
    approach: '타이포그래피·간격·상태를 공통 토큰으로 정리해 작은 요소 사이의 일관성을 살펴봅니다.',
    tags: ['Design system', 'CSS', 'Accessibility'],
    label: 'COMPONENT LIBRARY / 01',
    heading: 'The essentials.',
    cells: ['타입', '간격', '상태'],
    symbols: ['Aa', '↔', '○'],
  },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="흑백 디자인과 프로젝트 탐색 경험을 살펴보는 comchobo 포트폴리오 더미 페이지입니다."
    />
    <title>comchobo — Portfolio design preview</title>
  </head>
  <body>
    <a class="skip-link" href="#projects">프로젝트로 건너뛰기</a>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="comchobo 홈">comchobo.</a>
        <nav aria-label="주 탐색">
          <a href="#projects">Projects</a>
          <a href="https://github.com/comchobo">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main>
        <section class="intro" aria-labelledby="intro-title">
          <div>
            <p class="eyebrow">PORTFOLIO / DESIGN PREVIEW</p>
            <h1 id="intro-title">작은 문제를 발견하고,<br />명료한 도구를 만듭니다.</h1>
          </div>
          <p class="intro-description">
            아이디어를 작동하는 것으로 옮기는 과정.<br />
            프로젝트를 소개하는 방식을 탐구합니다.
          </p>
        </section>

        <section id="projects" aria-labelledby="projects-title">
          <div class="section-heading">
            <h2 id="projects-title">Selected projects</h2>
            <span class="eyebrow">01 — 03 / EXAMPLE WORK</span>
          </div>

          <div class="project-list" data-project-list>
            {
              projects.map((project, index) => (
                <article class="project" data-project>
                  <h3>
                    <button
                      class="project-heading"
                      id={`${project.id}-heading`}
                      type="button"
                      aria-expanded="true"
                      aria-controls={`${project.id}-panel`}
                    >
                      <span class="project-number" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="project-name">{project.name}</span>
                      <span class="project-summary">{project.summary}</span>
                    </button>
                  </h3>

                  <div
                    class="project-panel"
                    id={`${project.id}-panel`}
                    role="region"
                    aria-labelledby={`${project.id}-heading`}
                  >
                    <figure class="project-preview" aria-label={`${project.name} 가상 UI 예시`}>
                      <div class="sample-app" aria-hidden="true">
                        <div class="sample-topbar">
                          <strong>{project.name}</strong>
                          <span>○ &nbsp; ···</span>
                        </div>
                        <p class="sample-label">{project.label}</p>
                        <p class="sample-title">{project.heading}</p>
                        {index === 1 && (
                          <div class="sample-chart">
                            {[28, 46, 36, 62, 54, 80, 72, 94, 85, 100, 88, 100].map(
                              (height) => <span style={`height: ${height}%`} />,
                            )}
                          </div>
                        )}
                        <div class="sample-cells">
                          {project.cells.map((cell, cellIndex) => (
                            <div>
                              <span>{cell}</span>
                              <strong>{project.symbols[cellIndex]}</strong>
                            </div>
                          ))}
                        </div>
                        <div class="sample-lines"><span /><span /><span /></div>
                      </div>
                      <figcaption>CONCEPT INTERFACE / 예시 화면</figcaption>
                    </figure>

                    <div class="project-copy">
                      <p class="eyebrow">{project.tags[0]} / CONCEPT</p>
                      <p class="project-description">{project.description}</p>
                      <p class="project-approach">{project.approach}</p>
                      <ul class="tags" aria-label="예시 프로젝트 분류 및 기술">
                        {project.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                      <a class="project-link" href="#sample-note">
                        예시 안내 <span aria-hidden="true">↗</span>
                        <span class="sr-only"> — {project.name}</span>
                      </a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <aside class="sample-note" id="sample-note" aria-label="더미 콘텐츠 안내">
          <span class="eyebrow">ABOUT THIS PREVIEW</span>
          <p>
            디자인 검토를 위한 더미 페이지입니다. 프로젝트·기술 분류·인터페이스는 모두 가상의 예시이며,
            실제 작업 이력이나 성과를 나타내지 않습니다.
          </p>
        </aside>
      </main>

      <footer class="site-footer">
        <span>comchobo · Selected work</span>
        <span>Monochrome, by intention.</span>
      </footer>
    </div>
  </body>
</html>

<script>
  const list = document.querySelector<HTMLElement>('[data-project-list]');

  if (list) {
    const headings = Array.from(list.querySelectorAll<HTMLButtonElement>('.project-heading'));
    const panels = Array.from(list.querySelectorAll<HTMLElement>('.project-panel'));
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    let activeIndex = 0;
    let lastPointer: { x: number; y: number } | undefined;

    const activate = (index: number) => {
      activeIndex = index;
      headings.forEach((heading, itemIndex) => {
        const isOpen = itemIndex === index;
        heading.setAttribute('aria-expanded', String(isOpen));
        panels[itemIndex].hidden = !isOpen;
      });
    };

    // All content remains readable when JavaScript is unavailable.
    activate(0);

    headings.forEach((heading, index) => {
      heading.addEventListener('focus', () => activate(index));
      heading.addEventListener('click', () => activate(index));
      heading.addEventListener('pointermove', (event) => {
        if (!canHover.matches || event.pointerType !== 'mouse') return;

        // A layout change alone must not activate the row now under the pointer.
        if (lastPointer?.x === event.clientX && lastPointer?.y === event.clientY) return;
        lastPointer = { x: event.clientX, y: event.clientY };

        // Never hide a panel while a keyboard user is interacting with its links.
        if (panels[activeIndex].contains(document.activeElement)) return;
        if (headings[activeIndex] === document.activeElement && headings[activeIndex].matches(':focus-visible')) return;
        if (activeIndex !== index) activate(index);
      });
    });
  }
</script>

<style>
  :global(:root) {
    color-scheme: light dark;
    --color-primary: #171717;
    --color-on-primary: #ffffff;
    --color-surface: #fafafa;
    --color-surface-container: #ffffff;
    --color-on-surface: #171717;
    --color-on-surface-variant: #626262;
    --color-outline: #737373;
    --color-outline-variant: #d9d9d9;
    --color-surface-variant: #efefef;
    --font-family: Arial, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, monospace;
    --text-headline: clamp(1.875rem, 4.3vw, 3.375rem);
    --text-title: 1.5rem;
    --text-body: 1rem;
    --text-label: 0.875rem;
    --text-meta: 0.75rem;
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 0.75rem;
    --space-lg: 1rem;
    --space-xl: 1.5rem;
    --space-2xl: 2rem;
    --space-3xl: 3rem;
    --space-4xl: 4rem;
    --rounded-none: 0;
    --border-width: 1px;
    --focus-width: 2px;
    --focus-offset: 4px;
    --motion-duration: 160ms;
    --motion-easing: ease-out;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --color-primary: #f2f2f2;
      --color-on-primary: #171717;
      --color-surface: #111111;
      --color-surface-container: #181818;
      --color-on-surface: #f2f2f2;
      --color-on-surface-variant: #aaaaaa;
      --color-outline: #8a8a8a;
      --color-outline-variant: #393939;
      --color-surface-variant: #252525;
    }
  }

  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: var(--color-surface);
    color: var(--color-on-surface);
    font-family: var(--font-family);
    font-size: var(--text-body);
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-underline-offset: 0.3em; }
  :global(a:focus-visible), :global(button:focus-visible) {
    outline: var(--focus-width) solid var(--color-primary);
    outline-offset: var(--focus-offset);
  }
  :global(h1), :global(h2), :global(h3), :global(p), :global(figure) { margin: 0; }
  :global(button), :global(a) { -webkit-tap-highlight-color: transparent; }
  :global([hidden]) { display: none !important; }
  .shell { max-width: 1200px; margin-inline: auto; padding-inline: var(--space-4xl); }
  .skip-link { position: absolute; top: -100px; left: var(--space-lg); z-index: 2; padding: var(--space-md); background: var(--color-surface-container); }
  .skip-link:focus { top: var(--space-lg); }
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-xl); padding-block: var(--space-xl); border-bottom: var(--border-width) solid var(--color-outline-variant); }
  .wordmark { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.04em; text-decoration: none; }
  nav { display: flex; gap: var(--space-xl); font-size: var(--text-label); }
  nav a { min-height: 24px; }
  .intro { display: flex; align-items: end; justify-content: space-between; gap: var(--space-2xl); padding-block: var(--space-4xl); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-meta); font-weight: 400; line-height: 1.5; letter-spacing: 0.06em; }
  .intro .eyebrow { margin-bottom: var(--space-xl); }
  h1 { font-size: var(--text-headline); font-weight: 600; line-height: 1.25; letter-spacing: -0.05em; word-break: keep-all; text-wrap: balance; }
  .intro-description { max-width: 270px; color: var(--color-on-surface-variant); font-size: var(--text-label); line-height: 1.5; word-break: keep-all; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); padding-bottom: var(--space-lg); border-bottom: var(--border-width) solid var(--color-on-surface); }
  h2 { font-size: var(--text-label); font-weight: 500; }
  .section-heading .eyebrow { font-size: 0.625rem; }
  .project { border-bottom: var(--border-width) solid var(--color-outline-variant); }
  .project-heading { display: grid; grid-template-columns: 40px 1fr 1fr; align-items: baseline; gap: var(--space-xl); width: 100%; min-height: 80px; padding: var(--space-xl) 0; border: 0; border-radius: var(--rounded-none); background: transparent; color: var(--color-on-surface); text-align: left; font: inherit; cursor: pointer; }
  .project-number { font-family: var(--font-mono); color: var(--color-on-surface-variant); font-size: var(--text-meta); font-weight: 400; line-height: 1.5; letter-spacing: 0.06em; }
  .project-name { font-size: var(--text-title); font-weight: 600; line-height: 1.25; letter-spacing: -0.035em; overflow-wrap: anywhere; }
  .project-summary { color: var(--color-on-surface-variant); font-size: var(--text-label); font-weight: 400; line-height: 1.5; word-break: keep-all; }
  .project-heading[aria-expanded='true'] .project-name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  .project-heading:hover .project-name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  .project-panel { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-3xl); align-items: center; padding-bottom: var(--space-2xl); }
  .project-preview { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-xl); min-height: 330px; padding: var(--space-2xl); background: var(--color-surface-variant); overflow: hidden; }
  .sample-app { width: 100%; max-width: 390px; padding: var(--space-lg); border: var(--border-width) solid var(--color-outline-variant); background: var(--color-surface-container); }
  .sample-topbar { display: flex; justify-content: space-between; padding-bottom: var(--space-sm); margin-bottom: var(--space-lg); border-bottom: var(--border-width) solid var(--color-outline-variant); font-size: 0.625rem; }
  .sample-label { margin-bottom: var(--space-sm); color: var(--color-on-surface-variant); font-family: var(--font-mono); font-size: 0.5rem; }
  .sample-title { font-size: 1.375rem; line-height: 1.3; letter-spacing: -0.05em; font-weight: 600; }
  .sample-cells { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-sm); margin-top: var(--space-lg); }
  .sample-cells > div { padding: var(--space-md); border: var(--border-width) solid var(--color-outline-variant); font-size: 0.625rem; }
  .sample-cells strong { display: block; font-size: 1.125rem; font-weight: 500; }
  .sample-lines { display: grid; gap: var(--space-xs); margin-top: var(--space-lg); }
  .sample-lines span { height: 4px; width: 90%; background: var(--color-surface-variant); }
  .sample-lines span:nth-child(2) { width: 65%; }
  .sample-lines span:nth-child(3) { width: 78%; }
  .sample-chart { display: flex; align-items: end; gap: var(--space-xs); height: 40px; margin-top: var(--space-md); }
  .sample-chart span { flex: 1; background: var(--color-on-surface); }
  figcaption { color: var(--color-on-surface-variant); font-family: var(--font-mono); font-size: 0.625rem; }
  .project-copy { padding-right: var(--space-2xl); overflow-wrap: anywhere; }
  .project-copy .eyebrow { color: var(--color-on-surface-variant); }
  .project-description { margin-top: var(--space-lg); word-break: keep-all; }
  .project-approach { margin-top: var(--space-md); color: var(--color-on-surface-variant); font-size: var(--text-label); line-height: 1.5; word-break: keep-all; }
  .tags { display: flex; gap: var(--space-sm); flex-wrap: wrap; list-style: none; margin: var(--space-xl) 0; padding: 0; }
  .tags li { padding: var(--space-xs) var(--space-sm); border: var(--border-width) solid var(--color-outline-variant); font-size: var(--text-meta); line-height: 1.5; }
  .project-link { display: inline-block; min-height: 24px; font-size: var(--text-label); line-height: 1.5; }
  .sample-note { max-width: 680px; margin-top: var(--space-3xl); color: var(--color-on-surface-variant); font-size: var(--text-label); line-height: 1.5; scroll-margin-top: var(--space-xl); }
  .sample-note p { margin-top: var(--space-sm); word-break: keep-all; }
  .site-footer { display: flex; justify-content: space-between; gap: var(--space-lg); margin-top: var(--space-3xl); padding-block: var(--space-xl); border-top: var(--border-width) solid var(--color-outline-variant); color: var(--color-on-surface-variant); font-size: var(--text-meta); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  @media (max-width: 800px) {
    .shell { padding-inline: var(--space-xl); }
    .intro { display: block; padding-block: var(--space-3xl); }
    h1 { font-size: clamp(1.75rem, 7.8vw, 2.75rem); }
    .intro-description { margin-top: var(--space-xl); max-width: 360px; }
    .project-heading { grid-template-columns: 24px 1fr; gap: var(--space-sm) var(--space-lg); }
    .project-summary { grid-column: 2; }
    .project-panel { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .project-preview { min-height: 250px; padding: var(--space-xl); }
    .project-copy { padding-right: 0; }
    .site-footer { flex-wrap: wrap; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-panel { animation: reveal var(--motion-duration) var(--motion-easing); }
    @keyframes reveal { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
